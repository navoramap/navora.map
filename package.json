{
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "sharp": "^0.35.4"
  },
  "scripts": {
    "test:rules": "npx -y firebase-tools@14.22.0 emulators:exec --only firestore,storage \"node --test --test-concurrency=1 test/firestore.rules.test.cjs test/storage.rules.test.cjs\" --project demo-navora",
    "test:migration": "node --test test/firestore-migration.test.cjs",
    "test:migration:emulator": "npx -y firebase-tools@14.22.0 emulators:exec --only firestore \"node --test test/firestore-migration-emulator.test.cjs\" --project demo-navora-migration",
    "migrate:rooms": "node scripts/migrate_chat_rooms.cjs"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "uuid": "^11.1.1"
  }
}
